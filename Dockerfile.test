# Keep the Playwright runtime aligned with the version resolved by pnpm-lock.yaml.
FROM mcr.microsoft.com/playwright:v1.64.1-noble

WORKDIR /home/pwuser
RUN npm install -g npm@11.1.0 pnpm@9.15.9
RUN ln -sf /usr/share/zoneinfo/CET /etc/localtime
RUN mkdir -p /home/pwuser/tests /home/pwuser/.npm && chown -R pwuser /home/pwuser/

# Install the exact test dependencies before copying test sources.
COPY package.json pnpm-lock.yaml /home/pwuser/
RUN pnpm install --frozen-lockfile
COPY playwright.config.ts /home/pwuser/
COPY tests/ /home/pwuser/tests/
RUN chown -R pwuser /home/pwuser/
RUN pnpm exec playwright install chromium
